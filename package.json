{
  "name": "lagrange-images",
  "version": "0.0.31",
  "description": "Persistent image service and language platform for Lagrange",
  "type": "module",
  "main": "src/runtime.js",
  "exports": {
    ".": "./src/runtime.js",
    "./backend": "./src/backend/index.js",
    "./callable": "./src/callable/index.js",
    "./code": "./src/code/index.js",
    "./compilation": "./src/compilation/index.js",
    "./dispatch": "./src/dispatch/invocation-service.js",
    "./execution": "./src/execution/model.js",
    "./executor": "./src/execution/executor.js",
    "./foreign-runtime": "./src/foreign-runtime/index.js",
    "./graph": "./src/graph/references.js",
    "./language": "./src/language/index.js",
    "./object": "./src/object/index.js",
    "./project": "./src/project/index.js",
    "./toolchain": "./src/toolchain/index.js",
    "./value": "./src/value/index.js",
    "./wasm": "./src/wasm/index.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "demo": "node examples/graph-demo.js",
    "test": "node --test",
    "test:fast": "node --test --test-skip-pattern=\"exhaustive-recovery:\"",
    "test:recovery": "node --test --test-name-pattern=\"exhaustive-recovery:\"",
    "integration:setup": "scripts/integration-setup.sh",
    "test:integration": "bash -c 'source scripts/integration-env.sh && node --test test/opensmalltalk-cuis-real.test.js test/opensmalltalk-cuis-toolchain-real.test.js test/opensmalltalk-cuis-multipackage-real.test.js test/opensmalltalk-cuis-semantic-export-real.test.js test/cuis-export-materialize-real.test.js test/two-lane-callable-real.test.js'",
    "beads:init": "bd init --quiet --skip-agents",
    "beads:prime": "bd prime",
    "beads:ready": "bd ready --json"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@bytecodealliance/jco": ">=1.9.0",
    "lagrange-server": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@bytecodealliance/jco": {
      "optional": true
    },
    "lagrange-server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@beads/bd": "1.2.2",
    "@bytecodealliance/jco": "^1.29.0"
  },
  "license": "GPL-3.0"
}
