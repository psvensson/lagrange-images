package lagrange:proof@0.1.0;

// Deliberately mundane operations. Each one exists to prove that a canonical Value
// survives a round trip through the Component canonical ABI unchanged, not to be useful.
world normalize {
  // A named record, referenced from both a parameter and a result position. WIT requires
  // type declarations to live in a world or interface, not at package scope.
  record item {
    name: string,
    quantity: s64,
    enabled: bool,
  }

  // text fidelity: lowercase, collapse ASCII whitespace runs, trim
  export normalize: func(input: string) -> string;

  // binary fidelity: every byte value and ordering must survive
  export reverse: func(data: list<u8>) -> list<u8>;

  // numeric fidelity: IEEE 754 double multiply is exactly specified, so both lanes
  // must agree bit for bit
  export scale: func(value: f64, factor: f64) -> f64;

  // f32 precision: hyphenated on purpose, so the Component lane's WIT-name-to-export
  // mapping is exercised rather than assumed
  export echo-f32: func(value: f32) -> f32;

  // first composite: list<string> in and out, so the interface-composite/v0 codec is
  // exercised rather than array iteration
  export normalize-all: func(values: list<string>) -> list<string>;

  // record in, record out: quantity passes through untouched so s64 extremes are proven
  export relabel: func(it: item) -> item;

  // scalars in, record out: proves a record result independent of a record argument
  export make-item: func(name: string, quantity: s64) -> item;

  // list of record: the first composite whose element type is itself a composite, so the
  // codec has to recurse rather than special-case
  export relabel-all: func(items: list<item>) -> list<item>;
}
